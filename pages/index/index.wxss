.home {
    padding: 36rpx 32rpx 56rpx;
}

/* ---------- 头部 ---------- */
.hero {
    display: flex;
    flex-direction: column;
}

.hero-title {
    font-size: 60rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    line-height: 1.2;
    color: #1b1e23;
}

.hero-sub {
    margin-top: 14rpx;
    font-size: 25rpx;
    color: #8a9199;
    line-height: 1.5;
}

.stats {
    display: flex;
    align-items: center;
    margin-top: 34rpx;
    padding: 26rpx 8rpx;
    background: #ffffff;
    border-radius: 26rpx;
    box-shadow: 0 8rpx 26rpx rgba(24, 32, 48, 0.05);
}

.stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-num {
    font-size: 40rpx;
    font-weight: 700;
    color: #23262b;
    line-height: 1.1;
}

.stat-label {
    margin-top: 6rpx;
    font-size: 21rpx;
    color: #9aa1aa;
}

.stat-divider {
    width: 1rpx;
    height: 44rpx;
    background: #eef0f3;
}

/* ---------- 随机入口 ---------- */
.quick {
    display: flex;
    align-items: center;
    margin-top: 22rpx;
    padding: 28rpx 30rpx;
    border-radius: 26rpx;
    background: linear-gradient(135deg, #2f343b, #1b1e23);
}

.quick-main {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.quick-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
}

.quick-sub {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.55);
}

.quick-arrow {
    font-size: 34rpx;
    color: rgba(255, 255, 255, 0.75);
}

/* ---------- 分类 ---------- */
.chips {
    display: flex;
    margin: 30rpx 0 6rpx;
    white-space: nowrap;
}

.chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 13rpx 30rpx;
    margin-right: 14rpx;
    border-radius: 999rpx;
    background: #ffffff;
    font-size: 25rpx;
    color: #5a626b;
    box-shadow: 0 4rpx 14rpx rgba(24, 32, 48, 0.04);
}

.chip-active {
    background: #23262b;
    color: #ffffff;
    font-weight: 500;
}

/* ---------- 游戏网格 ---------- */
.grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 22rpx;
}

.card {
    width: calc((100% - 20rpx) / 2);
    margin-bottom: 20rpx;
    padding: 26rpx 24rpx 22rpx;
    background: #ffffff;
    border-radius: 30rpx;
    box-shadow: 0 8rpx 26rpx rgba(24, 32, 48, 0.05);
    transition: transform 0.12s ease;
}

.card:active {
    transform: scale(0.972);
}

.card-icon {
    width: 92rpx;
    height: 92rpx;
    border-radius: 26rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon-text {
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.5rpx;
}

.card-name {
    margin-top: 22rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #23262b;
}

.card-desc {
    margin-top: 8rpx;
    font-size: 22rpx;
    line-height: 1.45;
    color: #8a9199;
    height: 64rpx;
}

.card-foot {
    margin-top: 12rpx;
    display: flex;
}

.card-record {
    font-size: 20rpx;
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
    color: #b8792f;
    background: rgba(224, 134, 63, 0.11);
}

.card-record-empty {
    color: #9aa1aa;
    background: #f4f5f7;
}

/* ---------- 页脚 ---------- */
.footer {
    margin-top: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.footer-text {
    font-size: 21rpx;
    color: #b3b8bf;
}

.footer-link {
    margin-top: 18rpx;
    font-size: 22rpx;
    color: #8a9199;
    padding: 10rpx 26rpx;
    border-radius: 999rpx;
    background: #eef0f3;
}
